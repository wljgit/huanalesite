---
import LegalShell from "../../components/LegalShell.astro";
import { eulaText, splitLegalBlocks } from "../../lib/legal";
import { t } from "../../i18n/messages";

const locale = "en" as const;
const m = t(locale);
const blocks = splitLegalBlocks(eulaText(locale));
---

<LegalShell
  locale={locale}
  title={m.licenseMetaTitle}
  description={m.licenseMetaDescription}
  canonicalPath="/en/license/"
>
  {blocks.map((block) => <p class="legal-plain">{block}</p>)}
</LegalShell>

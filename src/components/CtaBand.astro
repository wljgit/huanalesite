---
import type { Locale } from "../lib/locale";
import { downloadUrl } from "../lib/download";
import { t } from "../i18n/messages";
import IconApple from "./icons/IconApple.astro";
import IconWindows from "./icons/IconWindows.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const m = t(locale);
---

<section class="section cta">
  <div class="wrap cta__inner">
    <h2>{m.ctaTitle}</h2>
    <p class="lead">{m.ctaLead}</p>
    <div class="actions">
      <a class="btn" href={downloadUrl("windows")}>
        <IconWindows />
        {m.downloadWindows}
      </a>
      <a class="btn btn--secondary" href={downloadUrl("macos")}>
        <IconApple />
        {m.downloadMac}
      </a>
    </div>
  </div>
</section>

<style>
  .cta__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta__inner .lead {
    margin-bottom: 1.5rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1rem;
  }

  .btn--secondary {
    background: #fff;
    color: var(--ink);
  }

  .btn--secondary:hover {
    opacity: 1;
    background: var(--soft);
  }
</style>

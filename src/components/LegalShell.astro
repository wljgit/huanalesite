---
import type { Locale } from "../lib/locale";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import { homePath } from "../lib/legal";
import { t } from "../i18n/messages";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  backLabel?: string;
}

const { locale, title, description, canonicalPath, backLabel } = Astro.props;
const m = t(locale);
const home = homePath(locale);
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  canonicalPath={canonicalPath}
>
  <SiteHeader locale={locale} />
  <main class="section legal">
    <div class="wrap">
      <p class="legal__back">
        <a class="link-quiet" href={home}>{backLabel ?? m.legalBackHome}</a>
      </p>
      <article class="legal__body">
        <slot />
      </article>
    </div>
  </main>
  <SiteFooter locale={locale} />
</BaseLayout>

<style>
  .legal {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  .legal__back {
    margin: 0 0 1.5rem;
    font-size: 0.92rem;
  }

  .legal__body :global(h1) {
    margin: 0 0 1rem;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
    font-weight: 700;
  }

  .legal__body :global(h2) {
    margin: 2rem 0 0.75rem;
    font-size: 1.15rem;
    font-weight: 700;
  }

  .legal__body :global(p),
  .legal__body :global(li),
  .legal__body :global(td),
  .legal__body :global(th),
  .legal__body :global(blockquote) {
    color: var(--muted);
    line-height: 1.7;
  }

  .legal__body :global(p) {
    margin: 0.75rem 0 0;
  }

  .legal__body :global(blockquote) {
    margin: 1rem 0 0;
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--line);
    background: var(--soft);
  }

  .legal__body :global(blockquote p) {
    margin: 0;
  }

  .legal__body :global(ul) {
    margin: 0.75rem 0 0;
    padding-left: 1.25rem;
  }

  .legal__body :global(li + li) {
    margin-top: 0.35rem;
  }

  .legal__body :global(strong) {
    color: var(--ink);
    font-weight: 700;
  }

  .legal__body :global(table) {
    width: 100%;
    margin: 1rem 0 0;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .legal__body :global(th),
  .legal__body :global(td) {
    border: 1px solid var(--line);
    padding: 0.65rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }

  .legal__body :global(th) {
    background: var(--soft);
    color: var(--ink);
    font-weight: 700;
  }

  .legal__body :global(hr) {
    border: none;
    border-top: 1px solid var(--line);
    margin: 2rem 0;
  }

  .legal__body :global(.legal-plain) {
    margin: 0;
    white-space: pre-wrap;
    font-family: inherit;
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--muted);
  }

  .legal__body :global(.legal-plain + .legal-plain) {
    margin-top: 1.1rem;
  }

  .legal__body :global(.legal-note) {
    margin-top: 1.5rem;
    padding: 0.85rem 1rem;
    background: var(--soft);
    border-radius: var(--radius);
    color: var(--muted);
    font-size: 0.92rem;
  }
</style>

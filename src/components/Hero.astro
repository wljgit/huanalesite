---
import type { Locale } from "../lib/locale";
import { SITE_GITHUB, downloadUrl } from "../lib/download";
import { t } from "../i18n/messages";
import IconApple from "./icons/IconApple.astro";
import IconWindows from "./icons/IconWindows.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const m = t(locale);
---

<section class="hero" id="download">
  <div class="wrap hero__inner">
    <p class="badge">{m.badge}</p>
    <h1>{m.headline}</h1>
    <p class="sub">{m.subhead}</p>
    <div class="actions">
      <a class="btn" href={downloadUrl("windows")}>
        <IconWindows />
        {m.downloadWindows}
      </a>
      <a class="btn btn--secondary" href={downloadUrl("macos")}>
        <IconApple />
        {m.downloadMac}
      </a>
      <a class="link-quiet" href={SITE_GITHUB}>{m.viewGithub}</a>
    </div>
    <p class="meta">{m.metaLine}</p>

    <figure class="preview">
      <img
        src="/screenshots/timeline.png"
        alt={m.screenshotAlt}
        width="1628"
        height="1055"
        loading="eager"
      />
    </figure>
  </div>
</section>

<style>
  .hero {
    padding: 4.5rem 0 2rem;
    text-align: left;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .badge {
    margin: 0 0 1.25rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: var(--badge-bg);
    color: var(--badge-ink);
    font-size: 0.82rem;
    font-weight: 600;
    width: fit-content;
  }

  h1 {
    margin: 0;
    max-width: 20em;
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    line-height: 1.25;
    letter-spacing: -0.03em;
    font-weight: 900;
    text-wrap: balance;
    text-align: left;
  }

  .sub {
    margin: 1.1rem 0 0;
    max-width: min(100%, 52rem);
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1.65;
    text-wrap: pretty;
    text-align: left;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 0.75rem 1rem;
    margin-top: 1.75rem;
  }

  .btn--secondary {
    background: #fff;
    color: var(--ink);
  }

  .btn--secondary:hover {
    opacity: 1;
    background: var(--soft);
  }

  .meta {
    margin: 1rem 0 0;
    color: #8a8a8a;
    font-size: 0.88rem;
  }

  .preview {
    margin: 3rem auto 0;
    width: min(100%, 920px);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    background: var(--soft);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.08);
  }

  .preview img {
    width: 100%;
    height: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .preview {
      animation: rise 0.7s ease both;
    }
  }

  @keyframes rise {
    from {
      opacity: 0.01;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
